
import discord
from discord.ext import commands

intents = discord.Intents.default()
intents.message_content = True

bot = commands.Bot(command_prefix="$", intents=intents)

@bot.event
async def on_ready():
    print("EcoBot está conectado!")

@bot.command()
async def hola(ctx):
    await ctx.send("¡Hola! Soy EcoBot 🌱")

@bot.command()
async def reciclar(ctx):
    await ctx.send("Papel y cartón: contenedor azul. Envases: amarillo. ¡Recicla!")

@bot.command()
async def consejos(ctx):
    await ctx.send("1. Usa bolsas reutilizables.\n2. Ahorra agua.\n3. Separa los residuos.\n4. Reutiliza botellas.")

@bot.command()
async def ayuda(ctx):
    await ctx.send("Comandos: $hola, $reciclar, $consejos")

bot.run("TU_TOKEN")
